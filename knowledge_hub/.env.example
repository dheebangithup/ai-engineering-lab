# ── Qdrant Vector Store Configuration ──────────────────────────────────
QDRANT_API_KEY=
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=enterprise_hub

# ── PostgreSQL Metadata Database ─────────────────────────────────────
POSTGRES_URL=postgresql://username:password@localhost:5432/knowledge_hub

# ── Local LM Studio Settings ──────────────────────────────────────────
LOCAL_LM_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5-GGUF
LOCAL_LM_URL=http://localhost:1234/v1
LOCAL_LM_API_KEY=lm-studio
LOCAL_LM_CHAT_MODEL=qwen2.5-7b-instruct-1m:3
LOCAL_LM_TEMPERATURE=0.7

# ── Groq API Settings ───────────────────────────────────────────────
GROQ_API_KEY=
GROQ_VISION_MODEL=llama-3.1-8b-instant

# ── Active RAG Retrieval & generation Settings ────────────────────────
LLM_PROVIDER=lm_studio     # Options: "groq" | "openai" | "lm_studio"
LLM_MODEL=qwen2.5-7b-instruct-1m:3

# ── Context Builder & Token Budgets ──────────────────────────────────
MAX_CONTEXT_TOKENS=6000
DEFAULT_SCORE_THRESHOLD=0.6
DEFAULT_TOP_K=5

# ── Automated Evaluation Settings ────────────────────────────────────
RAGAS_EVAL_PROVIDER=groq   # Options: "groq" | "openai" | "lm_studio"
RAGAS_EVAL_MODEL=llama-3.1-8b-instant

# ── Hybrid Retrieval & Fusion Settings ──────────────────────────────
DEFAULT_RETRIEVAL_MODE=dense      # Options: "dense" | "bm25" | "hybrid"
DEFAULT_BM25_WEIGHT=0.3
DEFAULT_DENSE_WEIGHT=0.7
BM25_TOP_K_MULTIPLIER=1.5
ENABLE_BM25_INDEX_ON_STARTUP=true